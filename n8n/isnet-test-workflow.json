        "jsCode": "const r=$input.first().json;const b=$('Fatura · Panel isteği').first().json.body||{};const m=r.body?.app_metadata||{};if(r.statusCode!==200||!r.body?.id||m.firma!=='gazi'||m.role==='seller')throw Error('Gazi yönetici oturumu gerekli.');const id=Number(b.siparis_no);if(!Number.isSafeInteger(id)||id<1)throw Error('Geçerli sipariş seçin.');if(b.ortam!=='test')throw Error('Yalnızca test ortamı kullanılabilir.');return [{json:{p_siparis_no:id,p_actor:r.body.id}}];"
